/* This file is for your main application CSS */

/* ========== 🐦‍🔥 ГЛУБИННОЕ ПАРЕНИЕ САКРАЛЬНЫХ СИМВОЛОВ ========== */
#sacred-floating-layer {
  pointer-events: none;
  user-select: none;
}

.sacred-floating-symbol {
  pointer-events: none;
  will-change: transform, opacity, filter;
}

/* Медитативное мерцание фона для символов */
.sacred-floating-symbol img {
  animation: sacred-glow 3s ease-in-out infinite;
}

@keyframes sacred-glow {
  0%, 100% {
    filter: drop-shadow(0 0 8px rgba(167,139,250,0.3));
  }
  50% {
    filter: drop-shadow(0 0 20px rgba(167,139,250,0.6))
            drop-shadow(0 0 40px rgba(251,191,36,0.2));
  }
}

/* ========== 🐦‍🔥 ГЛУБИННОЕ ПАРЕНИЕ (анимация) ========== */
@keyframes sacred-emerge {
    0% {
        opacity: 0;
        transform: scale(0.5) translateY(20px);
        filter: blur(10px) drop-shadow(0 0 20px rgba(255,215,0,0.7)) drop-shadow(0 0 50px rgba(255,215,0,0.35));
    }
    40% {
        opacity: 1;
        filter: blur(0px) drop-shadow(0 0 20px rgba(255,215,0,0.7)) drop-shadow(0 0 50px rgba(255,215,0,0.35));
    }
    80% {
        transform: scale(1) translateY(0);
        opacity: 1;
    }
    100% {
        opacity: 1;
        transform: scale(1) translateY(0);
        filter: drop-shadow(0 0 20px rgba(255,215,0,0.7)) drop-shadow(0 0 50px rgba(255,215,0,0.35));
    }
}


/* ============================================================
   🏛️ АКАДЕМИЯ — Ландшафт Сутр и Практик
   ============================================================ */

/* --- Основной ландшафт --- */
.academy-landscape {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;
  overflow: hidden;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1128 40%, #1a1035 65%, #2d1b4e 100%);
  color: #e6e0f0;
  font-family: 'Inter', sans-serif;
}

/* --- Живой фон: орбы, звёзды, горы --- */
.landscape-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.landscape-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.35;
  animation: orb-float 12s ease-in-out infinite;
}

.orb-1 {
  width: 350px;
  height: 350px;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.7) 0%, transparent 70%);
  top: -80px;
  left: -60px;
}

.orb-2 {
  width: 280px;
  height: 280px;
  background: radial-gradient(circle, rgba(236, 72, 153, 0.5) 0%, transparent 70%);
  top: 30%;
  right: -80px;
  animation-delay: -4s;
}

.orb-3 {
  width: 220px;
  height: 220px;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.4) 0%, transparent 70%);
  top: 55%;
  left: 30%;
  animation-delay: -8s;
}

@keyframes orb-float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20px) scale(1.05); }
}

.landscape-horizon {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 35%;
  background: linear-gradient(180deg, transparent 0%, rgba(44, 24, 78, 0.5) 60%, rgba(20, 14, 34, 0.8) 100%);
  z-index: 1;
}

.landscape-mountains {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  opacity: 0.5;
  pointer-events: none;
}

.mountains-1 {
  height: 180px;
  background:
    linear-gradient(135deg, transparent 48%, rgba(76, 52, 120, 0.8) 50%, transparent 52%) 0 0 / 200px 100% repeat-x,
    linear-gradient(45deg, transparent 48%, rgba(88, 60, 140, 0.7) 50%, transparent 52%) 100px 20px / 180px 100% repeat-x;
  bottom: 0;
}

.mountains-2 {
  height: 120px;
  background:
    linear-gradient(135deg, transparent 48%, rgba(40, 28, 70, 0.9) 50%, transparent 52%) 50px 0 / 160px 100% repeat-x;
  bottom: 0;
  opacity: 0.7;
}

.landscape-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background-image:
    radial-gradient(1px 1px at 25px 5px, rgba(255,255,255,0.8) 50%, transparent 50%),
    radial-gradient(1px 1px at 50px 25px, rgba(255,255,255,0.5) 50%, transparent 50%),
    radial-gradient(1.5px 1.5px at 125px 40px, rgba(255,255,255,0.7) 50%, transparent 50%),
    radial-gradient(1px 1px at 20px 80px, rgba(167,139,250,0.6) 50%, transparent 50%),
    radial-gradient(1.5px 1.5px at 100px 100px, rgba(255,255,255,0.4) 50%, transparent 50%),
    radial-gradient(1px 1px at 180px 60px, rgba(251,191,36,0.5) 50%, transparent 50%),
    radial-gradient(1px 1px at 220px 20px, rgba(255,255,255,0.6) 50%, transparent 50%),
    radial-gradient(1.5px 1.5px at 300px 90px, rgba(255,255,255,0.5) 50%, transparent 50%);
  background-size: 320px 120px;
  opacity: 0.7;
  animation: stars-twinkle 4s ease-in-out infinite alternate;
}

@keyframes stars-twinkle {
  from { opacity: 0.5; }
  to { opacity: 0.9; }
}

/* --- Шапка Академии --- */
.academy-header {
  position: relative;
  z-index: 5;
  text-align: center;
  padding: 3rem 1.5rem 1.5rem;
  max-width: 900px;
  margin: 0 auto;
}

.academy-title {
  font-family: 'Cormorant Garamond', 'Georgia', serif;
  font-size: clamp(2.2rem, 6vw, 3.5rem);
  font-weight: 400;
  letter-spacing: 0.06em;
  margin: 0 0 0.5rem;
  background: linear-gradient(135deg, #ffb347 0%, #ff3d00 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 0 30px rgba(255, 120, 0, 0.2);
}

.academy-subtitle {
  color: #aa8c7a;
  font-style: italic;
  font-size: 1rem;
  letter-spacing: 0.05em;
  margin: 0 0 1.5rem;
}

/* --- Табы --- */
.academy-tabs {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin-top: 0.5rem;
  position: relative;
  z-index: 6;
}

.academy-tab {
  background: rgba(20, 18, 34, 0.8);
  border: 1px solid rgba(255, 150, 60, 0.25);
  color: #aa8c7a;
  padding: 10px 24px;
  border-radius: 100px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  font-family: 'Inter', sans-serif;
  letter-spacing: 0.04em;
}

.academy-tab:hover {
  border-color: rgba(255, 150, 60, 0.5);
  color: #ffb380;
  transform: translateY(-2px);
}

.academy-tab.active {
  background: rgba(255, 100, 0, 0.2);
  border-color: rgba(255, 120, 0, 0.6);
  color: #ffd9b3;
  box-shadow: 0 0 25px rgba(255, 80, 0, 0.15);
}

.academy-tab.active::before {
  content: "✦ ";
  opacity: 0.7;
}

/* --- Сетка карточек --- */
.landscape-grid {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.2rem;
  padding: 1.5rem;
  max-width: 1150px;
  margin: 0 auto;
}

/* --- Анимированное появление карточек --- */
.landscape-card {
  position: relative;
  background: rgba(18, 16, 32, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 1.8rem 1.5rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  animation: card-emerge 0.6s ease forwards;
  opacity: 0;
  animation-delay: var(--delay, 0ms);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  overflow: hidden;
  font-family: inherit;
}

@keyframes card-emerge {
  0% {
    opacity: 0;
    transform: translateY(30px) scale(0.95);
    filter: blur(8px);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

.landscape-card:hover {
  transform: translateY(-6px);
  border-color: var(--card-color, #7C3AED);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4),
              0 0 30px color-mix(in srgb, var(--card-color, #7C3AED) 25%, transparent);
  z-index: 3;
}

/* Свечение под карточкой */
.card-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at 50% 0%,
    color-mix(in srgb, var(--card-color, #7C3AED) 20%, transparent) 0%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
}

.landscape-card:hover .card-glow {
  opacity: 1;
}

/* Иконка */
.card-icon {
  font-size: 2.8rem;
  display: block;
  margin-bottom: 0.8rem;
  filter: drop-shadow(0 0 12px color-mix(in srgb, currentColor 40%, transparent));
  transition: transform 0.3s ease;
}

.landscape-card:hover .card-icon {
  transform: scale(1.15) rotate(8deg);
}

/* Заголовок */
.card-title {
  font-family: 'Cormorant Garamond', 'Georgia', serif;
  font-size: 1.4rem;
  font-weight: 500;
  color: #e6dcc8;
  margin: 0 0 0.4rem;
  letter-spacing: 0.02em;
}

/* Длительность */
.card-duration {
  display: inline-block;
  font-size: 0.7rem;
  padding: 3px 12px;
  border-radius: 100px;
  font-weight: 500;
  letter-spacing: 0.05em;
  margin-bottom: 0.6rem;
}

/* Превью текста */
.card-preview {
  font-size: 0.85rem;
  color: #8a7d96;
  line-height: 1.5;
  margin: 0 0 1rem;
  min-height: 2.5em;
}

/* Кнопка входа */
.card-enter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 22px;
  border-radius: 100px;
  border: 1px solid;
  font-size: 0.85rem;
  font-weight: 500;
  color: #fff;
  letter-spacing: 0.06em;
  opacity: 0.85;
  transition: all 0.3s ease;
}

.landscape-card:hover .card-enter {
  opacity: 1;
  box-shadow: 0 4px 20px color-mix(in srgb, var(--card-color, #7C3AED) 40%, transparent);
  transform: scale(1.05);
}

.card-enter span {
  display: inline-block;
  transition: transform 0.3s ease;
}

.landscape-card:hover .card-enter span {
  transform: translateX(4px);
}

/* ============================================================
   🏛️ ПОЛНОЭКРАННАЯ ПАЛАТА СУТРЫ (chamber)
   ============================================================ */

.sutra-chamber {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 6, 16, 0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  animation: chamber-fade 0.4s ease;
  padding: 1rem;
  overflow-y: auto;
}

@keyframes chamber-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sutra-chamber-inner {
  position: relative;
  max-width: 700px;
  width: 100%;
  margin: auto;
  background: rgba(16, 14, 28, 0.95);
  border: 1px solid color-mix(in srgb, var(--chamber-color, #7C3AED) 40%, transparent);
  border-radius: 28px;
  padding: 3rem 2.5rem;
  text-align: center;
  animation: chamber-inner-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 0 60px color-mix(in srgb, var(--chamber-color, #7C3AED) 20%, transparent);
  overflow: hidden;
}

@keyframes chamber-inner-in {
  0% {
    opacity: 0;
    transform: translateY(40px) scale(0.9);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Свечение за карточкой */
.chamber-glow {
  position: absolute;
  top: -30%;
  left: 50%;
  transform: translateX(-50%);
  width: 500px;
  height: 400px;
  background: radial-gradient(
    circle,
    color-mix(in srgb, var(--glow-color, #7C3AED) 25%, transparent) 0%,
    transparent 70%
  );
  pointer-events: none;
  border-radius: 50%;
}

/* Кнопка закрытия */
.chamber-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.06);
  color: #8a7d96;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(8px);
  z-index: 2;
}

.chamber-close:hover {
  background: rgba(255, 80, 0, 0.2);
  color: #ffb380;
  transform: rotate(90deg);
}

/* Иконка */
.chamber-icon {
  font-size: 5rem;
  margin-bottom: 1rem;
  animation: chamber-icon-glow 3s ease-in-out infinite;
  position: relative;
  z-index: 1;
}

@keyframes chamber-icon-glow {
  0%, 100% {
    filter: drop-shadow(0 0 15px color-mix(in srgb, currentColor 40%, transparent));
    transform: scale(1);
  }
  50% {
    filter: drop-shadow(0 0 30px color-mix(in srgb, currentColor 60%, transparent));
    transform: scale(1.05);
  }
}

/* Заголовок */
.chamber-title {
  font-family: 'Cormorant Garamond', 'Georgia', serif;
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 500;
  color: #f0e6d8;
  margin: 0 0 0.6rem;
  letter-spacing: 0.04em;
  position: relative;
  z-index: 1;
}

/* Длительность */
.chamber-duration {
  display: inline-block;
  font-size: 0.8rem;
  padding: 4px 16px;
  border-radius: 100px;
  margin-bottom: 1.2rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  position: relative;
  z-index: 1;
}

/* Текст */
.chamber-text {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #b8a8c8;
  margin: 0;
  position: relative;
  z-index: 1;
  font-family: 'Georgia', serif;
  letter-spacing: 0.02em;
}

/* Разделительная линия */
.chamber-text::before {
  content: "◈";
  display: block;
  text-align: center;
  color: var(--chamber-color, #7C3AED);
  font-size: 1.2rem;
  margin-bottom: 1rem;
  opacity: 0.7;
}

/* --- Кнопка назад --- */
.academy-back {
  position: relative;
  z-index: 6;
  display: inline-block;
  margin: 1rem auto 2rem;
  padding: 10px 24px;
  border-radius: 100px;
  background: rgba(20, 18, 34, 0.8);
  border: 1px solid rgba(255, 150, 60, 0.2);
  color: #aa8c7a;
  font-size: 0.9rem;
  text-decoration: none;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  text-align: center;
}

.academy-back:hover {
  border-color: rgba(255, 150, 60, 0.5);
  color: #ffb380;
  transform: translateX(-4px);
}

/* --- Мобильная адаптивность --- */
@media (max-width: 768px) {
  .landscape-grid {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    padding: 1rem;
  }

  .academy-title {
    font-size: 2.2rem;
  }

  .academy-header {
    padding-top: 2rem;
  }

  .sutra-chamber-inner {
    padding: 2.5rem 1.5rem;
    border-radius: 20px;
  }

  .chamber-icon {
    font-size: 3.5rem;
  }

  .chamber-text {
    font-size: 1rem;
    line-height: 1.7;
  }
}

@media (max-width: 480px) {
  .landscape-grid {
    grid-template-columns: 1fr;
  }

  .academy-tabs {
    flex-wrap: nowrap;
  }

  .academy-tab {
    flex: 1;
    white-space: nowrap;
  }
}

/* Поддержка color-mix — фолбэк для старых браузеров */
@supports not (color: color-mix(in srgb, red, blue)) {
  .landscape-card:hover {
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
  }
  .card-glow {
    background: rgba(124, 58, 237, 0.08);
  }
  .sutra-chamber-inner {
    border-color: rgba(124, 58, 237, 0.35);
    box-shadow: 0 0 60px rgba(124, 58, 237, 0.2);
  }
  .chamber-glow {
    background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, transparent 70%);
  }
}
