msgid ""
msgstr ""
"Language: hi\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Изумрудное Сердце"
msgstr "पन्ना हृदय"

msgid "Сад смыслов — путь к глубине"
msgstr "अर्थों का उद्यान — गहराई का मार्ग"

msgid "Познание"
msgstr "ज्ञान"

msgid "Сообщество"
msgstr "समुदाय"

msgid "Войти"
msgstr "लॉग इन"

msgid "Войди в глубину — каждый Смысл открывает дверь"
msgstr "गहराई में प्रवेश करें — हर अर्थ एक द्वार खोलता है"

msgid "Общий круг — совместное восхождение"
msgstr "साझा मंडल — सामूहिक आरोहण"

msgid "Вернуться к залам"
msgstr "हॉल में वापस जाएँ"

msgid "Смыслы"
msgstr "अर्थ"

msgid "Практики"
msgstr "अभ्यास"

msgid "Читать"
msgstr "पढ़ें"

msgid "Свернуть"
msgstr "संक्षिप्त करें"

msgid "Общий круг"
msgstr "साझा मंडल"

msgid "Путь вместе"
msgstr "एक साथ रास्ता"

msgid "Живой диалог"
msgstr "जीवंत संवाद"

msgid "Пространство соединения душ, где каждый смысл обогащается в диалоге с другими."
msgstr "आत्माओं के संबंध का स्थान, जहाँ हर अर्थ दूसरों के संवाद में समृद्ध होता है।"

msgid "Совместная практика и взаимная поддержка на пути к постижению глубины."
msgstr "गहराई को समझने के मार्ग पर साझा अभ्यास और आपसी समर्थन।"

msgid "Пространство открытого обмена — где слова становятся мостами между сердцами."
msgstr "खुले आदान-प्रदान का स्थान — जहाँ शब्द दिलों के बीच पुल बनते हैं।"

msgid "Назад"
msgstr "वापस"

msgid "Страница не найдена"
msgstr "पृष्ठ नहीं मिला"

msgid "Поиск по смыслу..."
msgstr "अर्थ से खोजें..."

msgid "Найдено"
msgstr "मिला"

msgid "результатов"
msgstr "परिणाम"

msgid "Ничего не найдено"
msgstr "कुछ नहीं मिला"

msgid "Феникс"
msgstr "फीनिक्स"

msgid "Интернет"
msgstr "इंटरनेट"

