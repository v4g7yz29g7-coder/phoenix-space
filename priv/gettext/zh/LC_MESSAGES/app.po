msgid "Изумрудное Сердце"
msgstr "翡翠之心"

msgid "Сад смыслов — путь к глубине"
msgstr "意义之园 — 通往深处之路"

msgid "Познание"
msgstr "认知"

msgid "Сообщество"
msgstr "社区"

msgid "Войти"
msgstr "登录"

msgid "Войди в глубину — каждый Смысл открывает дверь"
msgstr "进入深处 — 每一个意义都打开一扇门"

msgid "Общий круг — совместное восхождение"
msgstr "共同之圆 — 共同攀登"

msgid "Вернуться к залам"
msgstr "返回大厅"

msgid "Смыслы"
msgstr "意义"

msgid "Практики"
msgstr "实践"

msgid "Читать"
msgstr "阅读"

msgid "Свернуть"
msgstr "收起"

msgid "Общий круг"
msgstr "共同之圆"

msgid "Путь вместе"
msgstr "同行之路"

msgid "Живой диалог"
msgstr "活的对话"

msgid "Пространство соединения душ, где каждый смысл обогащается в диалоге с другими."
msgstr "灵魂连接的空间，每个意义都在与他人的对话中得到丰富。"

msgid "Совместная практика и взаимная поддержка на пути к постижению глубины."
msgstr "共同的实践和相互支持，通往深度理解的旅程。"

msgid "Пространство открытого обмена — где слова становятся мостами между сердцами."
msgstr "开放交流的空间 — 语言成为心灵之间的桥梁。"

msgid "Назад"
msgstr "返回"

msgid "Страница не найдена"
msgstr "未找到页面"

msgid "Поиск по смыслу..."
msgstr "按意义搜索..."

msgid "Найдено"
msgstr "找到"

msgid "результатов"
msgstr "结果"

msgid "Ничего не найдено"
msgstr "未找到任何内容"

