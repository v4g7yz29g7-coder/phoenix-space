msgid "Изумрудное Сердце"
msgstr "القلب الزمردي"

msgid "Сад смыслов — путь к глубине"
msgstr "حديقة المعاني — الطريق إلى العمق"

msgid "Познание"
msgstr "المعرفة"

msgid "Сообщество"
msgstr "المجتمع"

msgid "Войти"
msgstr "تسجيل الدخول"

msgid "Войди в глубину — каждый Смысл открывает дверь"
msgstr "ادخل إلى العمق — كل معنى يفتح باباً"

msgid "Общий круг — совместное восхождение"
msgstr "دائرة مشتركة — صعود جماعي"

msgid "Вернуться к залам"
msgstr "العودة إلى القاعات"

msgid "Смыслы"
msgstr "المعاني"

msgid "Практики"
msgstr "الممارسات"

msgid "Читать"
msgstr "قراءة"

msgid "Свернуть"
msgstr "طيّ"

msgid "Общий круг"
msgstr "الدائرة المشتركة"

msgid "Путь вместе"
msgstr "الطريق معاً"

msgid "Живой диалог"
msgstr "حوار حي"

msgid "Пространство соединения душ, где каждый смысл обогащается в диалоге с другими."
msgstr "مساحة لاتصال الأرواح، حيث يتثري كل معنى عبر الحوار مع الآخرين."

msgid "Совместная практика и взаимная поддержка на пути к постижению глубины."
msgstr "ممارسة مشتركة ودعم متبادل على طريق فهم العمق."

msgid "Пространство открытого обмена — где слова становятся мостами между сердцами."
msgstr "مساحة للتبادل المفتوح — حيث تصبح الكلمات جسوراً بين القلوب."

msgid "Назад"
msgstr "رجوع"

msgid "Страница не найдена"
msgstr "الصفحة غير موجودة"

msgid "Поиск по смыслу..."
msgstr "ابحث حسب المعنى..."

msgid "Найдено"
msgstr "تم العثور"

msgid "результатов"
msgstr "نتائج"

msgid "Ничего не найдено"
msgstr "لم يتم العثور على شيء"

msgid "Феникс"
msgstr "فينيكس"

msgid "Интернет"
msgstr "الإنترنت"

