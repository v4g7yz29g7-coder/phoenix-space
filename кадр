## 2. Создаем CSS для макетов

/* /home/ishidin/phoenix/public/css/layouts.css */
.layout-selector {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}

.layout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.layout-card {
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    padding: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #fff;
}

.layout-card:hover {
    border-color: #007bff;
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.1);
}

.layout-card.selected {
    border-color: #007bff;
    background: #f8f9fa;
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.2);
}

.layout-preview {
    width: 100%;
    height: 200px;
    border: 1px solid #ddd;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 10px;
    background: #f5f5f5;
}

.layout-preview-large {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.layout-preview-large .header {
    height: 40px;
    background: #007bff;
    opacity: 0.8;
}

.layout-preview-large .content {
    flex: 1;
    display: flex;
    padding: 10px;
    gap: 10px;
}

.layout-preview-large .main-content {
    flex: 2;
    background: #e9ecef;
    border-radius: 4px;
}

.layout-preview-large .sidebar {
    flex: 1;
    background: #dee2e6;
    border-radius: 4px;
}

.layout-preview-large .footer {
    height: 30px;
    background: #6c757d;
    opacity: 0.8;
}

.layout-info {
    text-align: center;
}

.layout-info h3 {
    margin: 10px 0 5px;
    color: #333;
}

.layout-info p {
    color: #666;
    font-size: 14px;
    margin: 0;
}

.layout-actions {
    margin-top: 20px;
    text-align: center;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    margin: 0 10px;
    transition: all 0.3s ease;
}

.btn-primary {
    background: #007bff;
    color: white;
}

.btn-primary:hover {
    background: #0056b3;
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn-secondary:hover {
    background: #545b62;
}

## 3. Создаем JavaScript для выбора макета

// /home/ishidin/phoenix/public/js/layouts/layout-selector.js
class LayoutSelector {
    constructor() {
        this.selectedLayout = null;
        this.layouts = [
            {
                id: 'large',
                name: 'Крупный макет',
                description: 'Большой контент с боковой панелью',
                preview: 'large'
            },
            {
                id: 'medium',
                name: 'Средний макет',
                description: 'Сбалансированный контент',
                preview: 'medium'
            },
            {
                id: 'compact',
                name: 'Компактный макет',
                description: 'Минималистичный дизайн',
                preview: 'compact'
            }
        ];
        
        this.init();
    }
    
    init() {
        this.renderLayoutGrid();
        this.bindEvents();
        this.loadSavedLayout();
    }
    
    renderLayoutGrid() {
        const grid = document.getElementById('layoutGrid');
        if (!grid) return;
        
        grid.innerHTML = this.layouts.map(layout => `
            <div class="layout-card" data-layout-id="${layout.id}">
                <div class="layout-preview">
                    ${this.getPreviewHTML(layout.preview)}
                </div>
                <div class="layout-info">
                    <h3>${layout.name}</h3>
                    <p>${layout.description}</p>
                </div>
            </div>
        `).join('');
    }
    
    getPreviewHTML(type) {
        switch(type) {
            case 'large':
                return `
                    <div class="layout-preview-large">
                        <div class="header"></div>
                        <div class="content">
                            <div class="main-content"></div>
                            <div class="sidebar"></div>
                        </div>
                        <div class="footer"></div>
                    </div>
                `;
            case 'medium':
                return `
                    <div class="layout-preview-large">
                        <div class="header" style="height: 30px;"></div>
                        <div class="content" style="padding: 5px;">
                            <div class="main-content" style="flex: 1.5;"></div>
                            <div class="sidebar" style="flex: 1;"></div>
                        </div>
                        <div class="footer" style="height: 20px;"></div>
                    </div>
                `;
            case 'compact':
                return `
                    <div class="layout-preview-large">
                        <div class="header" style="height: 20px;"></div>
                        <div class="content" style="padding: 3px;">
                            <div class="main-content" style="flex: 1;"></div>
                        </div>
                        <div class="footer" style="height: 15px;"></div>
                    </div>
                `;
            default:
                return '';
        }
    }
    
