# ============================================================================
#  ФЕНИКС — ПРОДАКШН-КОНФИГУРАЦИЯ
#  Никогда не коммитьте этот файл в Git!
#  Скопируйте в .env и заполните реальными значениями.
# ============================================================================

# --- Сервер ---
PORT=3000
NODE_ENV=production

# --- Безопасность (СЕКРЕТЫ — перегенерируйте на каждый деплой!) ---
JWT_SECRET=b510ee8fbe060968ab51bd20c8fc2ab3750c8f112564bf85b78c2b437e25ac4d
ADMIN_SECRET=8a9fa05e5c624e0c344c58ab3009f5ec
SESSION_SECRET=ec9249c79632b1c99e88d77a98ed2a47

# --- Блокчейн (Polygon/Mumbai) ---
# RPC для продакшена — рекомендуем официальный или Infura/Alchemy
POLYGON_RPC=https://rpc-mumbai.maticvigil.com
BLOCKCHAIN_RPC=https://rpc-mumbai.maticvigil.com

# Адрес развёрнутого контракта Феникса
CONTRACT_ADDRESS=0xEcB5666779430EA841bcb2f0F62A571B19577732

# Приватный ключ деплойера — для продакшена ЗАПИСАТЬ ЗАПОЛНИТЕ из безопасного хранилища!
DEPLOYER_KEY=
# Ключ для подписания блокчейн-операций (рекомендуется отдельный от deploy)
BLOCKCHAIN_KEY=

# --- База данных ---
# SQLite файл хранится локально, но можно указать путь
DB_PATH=./phoenix.db

# --- CORS — ограничьте для продакшена ---
CORS_ORIGIN=https://phoenixsearch.ru,https://www.phoenixsearch.ru
