<div class="academy-landscape">
  <!-- Живой фоновый ландшафт -->
  <div class="landscape-bg">
    <div class="landscape-orb orb-1"></div>
    <div class="landscape-orb orb-2"></div>
    <div class="landscape-orb orb-3"></div>
    <div class="landscape-horizon"></div>
    <div class="landscape-mountains mountains-1"></div>
    <div class="landscape-mountains mountains-2"></div>
    <div class="landscape-stars" id="stars"></div>
  </div>

  <%= if @not_found do %>
    <div class="page-nav-top">
      <a href="/" class="btn-back-top">← <%= gettext("Назад") %></a>
    </div>
    <div class="academy-header">
      <h1 class="academy-title">404</h1>
      <p class="academy-subtitle"><%= gettext("Страница не найдена") %></p>
    </div>
    <a href="/soobshestvo" class="academy-back">← <%= gettext("Вернуться к залам") %></a>
  <% else %>
    <div class="page-nav-top">
      <a href="/soobshestvo" class="btn-back-top">← <%= gettext("Назад") %></a>
    </div>

    <div class="academy-header">
      <div class="community-glyph community-glyph-detail" style={"--ccolor: #{@color}"}>
        <img src={~p"/assets/shapes/#{@icon}"} alt={@title_key} />
      </div>
      <h1 class="academy-title" style={"color: #{@color}"}><%= @title_key %></h1>
      <p class="academy-subtitle"><%= @description_key %></p>
    </div>

    <div class="detail-content">
      <div class="detail-card">
        <p class="detail-text"><%= @full_text %></p>
      </div>
    </div>

    <a href="/soobshestvo" class="academy-back">← <%= gettext("Вернуться к залам") %></a>
  <% end %>
</div>
