# ============================================================================
#  ФЕНИКС — Пример переменных окружения
#  Скопируйте этот файл в .env и заполните реальными значениями:
#    cp .env.example .env
# ============================================================================

# --- Сервер ---
PORT=3000
NODE_ENV=production

# --- Безопасность ---
# Генерируйте уникальные для каждой среды!
#   openssl rand -hex 32
JWT_SECRET=change-me-to-random-64-char-hex
ADMIN_SECRET=change-me-random-32-char-hex
SESSION_SECRET=change-me-random-32-char-hex

# --- Блокчейн (Polygon) ---
# Тестовая сеть Mumbai (замените на mainnet при реальном деплое)
POLYGON_RPC=https://rpc-mumbai.maticvigil.com
BLOCKCHAIN_RPC=https://rpc-mumbai.maticvigil.com

# Адрес развёрнутого контракта
CONTRACT_ADDRESS=

# Приватные ключи — в продакшене используйте защищённое хранилище секретов!
DEPLOYER_KEY=
BLOCKCHAIN_KEY=

# --- База данных ---
DB_PATH=./phoenix.db

# --- CORS — список доменов через запятую ---
CORS_ORIGIN=https://example.com
